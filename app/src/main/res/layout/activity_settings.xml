<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Btn.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="← 返回" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 一组：功能开关 -->
            <TextView style="@style/Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="功能" android:textAllCaps="true" android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                style="@style/Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Body" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="广告拦截" />

                    <TextView style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="命中黑名单的请求返回空" />
                </LinearLayout>

                <Button android:id="@+id/swAdblock" style="@style/Btn.Primary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="● 已启用" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Body" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="用户脚本（油猴）" />

                    <TextView style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="支持 @match + GM_setValue / GM_getValue" />
                </LinearLayout>

                <Button android:id="@+id/swScript" style="@style/Btn.Primary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="● 已启用" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Body" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="视频嗅探" />

                    <TextView style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="捕获 .mp4 / .m3u8 / .flv 视频源" />
                </LinearLayout>

                <Button android:id="@+id/swSniffer" style="@style/Btn.Primary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="● 已启用" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card.Surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Body" android:textStyle="bold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="DoNotTrack" />

                    <TextView style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="请求携带 DNT: 1 头" />
                </LinearLayout>

                <Button android:id="@+id/swDnt" style="@style/Btn.Primary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="● 已启用" />
            </LinearLayout>

            <!-- 二组：内容 -->
            <TextView style="@style/Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="内容" android:textAllCaps="true" android:letterSpacing="0.1"
                android:layout_marginTop="24dp" android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnScripts"
                style="@style/Btn.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:text="📜  管理用户脚本" />

            <Button
                android:id="@+id/btnUa"
                style="@style/Btn.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:layout_marginTop="8dp"
                android:text="🪪  自定义 User-Agent" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
